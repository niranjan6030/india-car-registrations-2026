{
  "name": "India Autos 2026 - Midnight",
  "dataColors": [
    "#3B82F6", "#F59E0B", "#22C55E", "#EC4899", "#06B6D4",
    "#A78BFA", "#F97316", "#84CC16", "#EF4444", "#14B8A6",
    "#EAB308", "#6366F1"
  ],
  "background": "#0B1220",
  "foreground": "#E6ECF5",
  "tableAccent": "#F59E0B",
  "good": "#22C55E",
  "neutral": "#94A3B8",
  "bad": "#EF4444",
  "maximum": "#22C55E",
  "center": "#1E3A5F",
  "minimum": "#0F1B2E",
  "textClasses": {
    "callout":  { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title":    { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#E6ECF5" },
    "header":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E6ECF5" },
    "label":    { "fontSize": 10, "fontFace": "Segoe UI", "color": "#94A3B8" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#111A2E" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1F2B45" } }, "radius": 12 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E6ECF5" } }, "fontSize": 13 }],
        "visualHeader": [{ "background": { "solid": { "color": "#111A2E" } }, "foreground": { "solid": { "color": "#94A3B8" } } }],
        "categoryAxis": [{ "gridlineShow": false, "labelColor": { "solid": { "color": "#94A3B8" } } }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#1F2B45" } }, "labelColor": { "solid": { "color": "#94A3B8" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#CBD5E1" } } }],
        "labels": [{ "color": { "solid": { "color": "#E6ECF5" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1220" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#070C16" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 28 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#94A3B8" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "fontColor": { "solid": { "color": "#E6ECF5" } }, "background": { "solid": { "color": "#111A2E" } } }],
        "header": [{ "fontColor": { "solid": { "color": "#F59E0B" } } }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#F59E0B" } }, "backColor": { "solid": { "color": "#0F1B2E" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E6ECF5" } }, "backColorPrimary": { "solid": { "color": "#111A2E" } },
                     "fontColorSecondary": { "solid": { "color": "#E6ECF5" } }, "backColorSecondary": { "solid": { "color": "#0F1B2E" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#F59E0B" } }, "backColor": { "solid": { "color": "#0F1B2E" } } }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#E6ECF5" } }, "backColor": { "solid": { "color": "#111A2E" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E6ECF5" } }, "backColorPrimary": { "solid": { "color": "#111A2E" } } }]
      }
    }
  }
}
