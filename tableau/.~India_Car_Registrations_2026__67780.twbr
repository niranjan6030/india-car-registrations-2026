      <aliases enabled='yes' />
      <column caption='EV Registrations' datatype='integer' name='[Calculation_ev_reg]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Is EV] THEN [Registrations] ELSE 0 END' />
      </column>
      <column caption='EV Share' datatype='real' default-format='p0.0%' name='[Calculation_ev_share]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_ev_reg]) / SUM([Registrations])' />
      </column>
      <column caption='Cars Per Day' datatype='real' default-format='n#,##0' name='[Calculation_per_day]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Registrations]) / SUM({ FIXED [Month Name] : MAX([Days Covered]) })' />
      </column>
