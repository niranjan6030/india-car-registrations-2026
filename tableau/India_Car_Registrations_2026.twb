<?xml version='1.0' encoding='utf-8' ?>
<workbook locale='en_US' source-build='2026.2.2 (20262.26.0819.2015)' source-platform='mac'
          version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='India Car Registrations 2026' inline='true' name='CarData' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='tableau_cars_flat' name='CarDataleaf'>
            <connection character-set='UTF-8' class='textscan' directory='Data'
                        driver='' filename='tableau_cars_flat.csv' force-character-set='no'
                        force-header='no' force-separator='no' header='yes' separator=','
                        text-qualifier='&quot;' />
          </named-connection>
        </named-connections>
        <relation connection='CarDataleaf' name='tableau_cars_flat#csv' table='[tableau_cars_flat#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=',' text-qualifier='&quot;'>
            <column datatype='date' name='Month' ordinal='0' />
            <column datatype='string' name='State' ordinal='1' />
            <column datatype='string' name='Maker (legal entity)' ordinal='2' />
            <column datatype='string' name='Powertrain' ordinal='3' />
            <column datatype='integer' name='Registrations' ordinal='4' />
            <column datatype='string' name='Brand' ordinal='5' />
            <column datatype='string' name='Parent Group' ordinal='6' />
            <column datatype='string' name='Origin Country' ordinal='7' />
            <column datatype='string' name='Region' ordinal='8' />
            <column datatype='string' name='State Code' ordinal='9' />
            <column datatype='string' name='State or UT' ordinal='10' />
            <column datatype='string' name='Map Location' ordinal='11' />
            <column datatype='string' name='Month Name' ordinal='12' />
            <column datatype='integer' name='Month Number' ordinal='13' />
            <column datatype='string' name='Quarter' ordinal='14' />
            <column datatype='integer' name='Days Covered' ordinal='15' />
            <column datatype='boolean' name='Is Partial Month' ordinal='16' />
            <column datatype='boolean' name='Is EV' ordinal='17' />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>Month</remote-name>
            <remote-type>7</remote-type>
            <local-name>[Month]</local-name>
            <parent-name>[tableau_cars_flat#csv]</parent-name>
            <remote-alias>Month</remote-alias>
            <ordinal>0</ordinal>
            <local-type>date</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>State</remote-name>
            <remote-type>129</remote-type>
            <local-name>[State]</local-name>
            <parent-name>[tableau_cars_flat#csv]</parent-name>
