            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Registrations]' role='measure' type='quantitative' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Registrations]' derivation='Sum' name='[sum:Registrations:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#111a2e' />
          </style-rule>
        </style>
        <panes>
          <pane id='1'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[CarData].[none:Region:nk]</rows>
        <cols>[CarData].[sum:Registrations:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Origin Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e6ecf5' fontsize='11'>Where the brands come from</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='India Car Registrations 2026' name='CarData' />
          </datasources>
          <datasource-dependencies datasource='CarData'>
            <column datatype='string' name='[Origin Country]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Registrations]' role='measure' type='quantitative' />
            <column-instance column='[Origin Country]' derivation='None' name='[none:Origin Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Registrations]' derivation='Sum' name='[sum:Registrations:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#111a2e' />
          </style-rule>
        </style>
        <panes>
          <pane id='1'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[CarData].[none:Origin Country:nk]</rows>
        <cols>[CarData].[sum:Registrations:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='State EV Detail'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e6ecf5' fontsize='11'>EV share by state and brand</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='India Car Registrations 2026' name='CarData' />
          </datasources>
          <datasource-dependencies datasource='CarData'>
            <column datatype='string' name='[State]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
            <column caption='EV Share' datatype='real' default-format='p0.0%' name='[Calculation_ev_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_ev_reg]) / SUM([Registrations])' />
            </column>
            <column-instance column='[State]' derivation='None' name='[none:State:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_ev_share]' derivation='Sum' name='[sum:Calculation_ev_share:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#111a2e' />
          </style-rule>
        </style>
        <panes>
          <pane id='1'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[CarData].[none:State:nk]</rows>
        <cols>[CarData].[sum:Calculation_ev_share:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f59e0b' fontsize='16'>India&apos;s Car Market 2026 - 22.9 lakh cars registered, 1 Jan to 17 Jun</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='dashboard'>
          <format attr='background-color' value='#0b1220' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <datasources>
        <datasource caption='India Car Registrations 2026' name='CarData' />
      </datasources>
      <datasource-dependencies datasource='CarData'>
            <column datatype='integer' name='[Registrations]' role='measure' type='quantitative' />
            <column caption='EV Share' datatype='real' default-format='p0.0%' name='[Calculation_ev_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_ev_reg]) / SUM([Registrations])' />
            </column>
            <column caption='EV Registrations' datatype='integer' name='[Calculation_ev_reg]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Is EV] THEN [Registrations] ELSE 0 END' />
            </column>
            <column caption='Cars Per Day' datatype='real' default-format='n#,##0' name='[Calculation_per_day]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Registrations]) / SUM({ FIXED [Month Name] : MAX([Days Covered]) })' />
            </column>
            <column datatype='string' name='[Origin Country]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Powertrain]' role='dimension' type='nominal' />
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
            <zone h='7000' id='2' type-v2='text' w='100000' x='0' y='0'>
              <formatted-text>
                <run bold='true' fontcolor='#f59e0b' fontsize='16'>India&apos;s Car Market 2026 - 22.9 lakh cars registered, 1 Jan to 17 Jun</run>
              </formatted-text>
              <zone-style>
                <format attr='background-color' value='#0b1220' />
                <format attr='border-style' value='none' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='15000' id='11' name='Total Cars' w='25000' x='0' y='7000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='15000' id='12' name='EV Share KPI' w='25000' x='25000' y='7000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='15000' id='13' name='Origin Country' w='50000' x='50000' y='7000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='40000' id='14' name='Monthly Trend' w='55000' x='0' y='22000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='40000' id='15' name='Top Brands' w='45000' x='55000' y='22000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='38000' id='16' name='Region Split' w='100000' x='0' y='62000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
        </zone>
      </zones>
    </dashboard>
    <dashboard name='The EV Shift'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f59e0b' fontsize='16'>The EV Shift - 3.5% of new cars in January, 7.5% by June</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='dashboard'>
          <format attr='background-color' value='#0b1220' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <datasources>
        <datasource caption='India Car Registrations 2026' name='CarData' />
      </datasources>
      <datasource-dependencies datasource='CarData'>
            <column datatype='integer' name='[Registrations]' role='measure' type='quantitative' />
            <column caption='EV Share' datatype='real' default-format='p0.0%' name='[Calculation_ev_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_ev_reg]) / SUM([Registrations])' />
            </column>
            <column caption='EV Registrations' datatype='integer' name='[Calculation_ev_reg]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Is EV] THEN [Registrations] ELSE 0 END' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column datatype='string' name='[State]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
            <zone h='7000' id='2' type-v2='text' w='100000' x='0' y='0'>
              <formatted-text>
                <run bold='true' fontcolor='#f59e0b' fontsize='16'>The EV Shift - 3.5% of new cars in January, 7.5% by June</run>
              </formatted-text>
              <zone-style>
                <format attr='background-color' value='#0b1220' />
                <format attr='border-style' value='none' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='35000' id='21' name='EV Share Curve' w='100000' x='0' y='7000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='58000' id='22' name='EV Brands' w='50000' x='0' y='42000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='58000' id='23' name='State EV Share' w='50000' x='50000' y='42000'>
              <zone-style>
                <format attr='border-color' value='#1f2b45' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
