            <remote-type>129</remote-type>
            <local-name>[Month Name]</local-name>
            <parent-name>[tableau_cars_flat#csv]</parent-name>
            <remote-alias>Month Name</remote-alias>
            <ordinal>12</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Month Number</remote-name>
            <remote-type>20</remote-type>
            <local-name>[Month Number]</local-name>
            <parent-name>[tableau_cars_flat#csv]</parent-name>
            <remote-alias>Month Number</remote-alias>
            <ordinal>13</ordinal>
            <local-type>integer</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Quarter</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Quarter]</local-name>
            <parent-name>[tableau_cars_flat#csv]</parent-name>
            <remote-alias>Quarter</remote-alias>
            <ordinal>14</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Days Covered</remote-name>
            <remote-type>20</remote-type>
            <local-name>[Days Covered]</local-name>
            <parent-name>[tableau_cars_flat#csv]</parent-name>
            <remote-alias>Days Covered</remote-alias>
            <ordinal>15</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Is Partial Month</remote-name>
            <remote-type>11</remote-type>
            <local-name>[Is Partial Month]</local-name>
            <parent-name>[tableau_cars_flat#csv]</parent-name>
            <remote-alias>Is Partial Month</remote-alias>
            <ordinal>16</ordinal>
            <local-type>boolean</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Is EV</remote-name>
            <remote-type>11</remote-type>
            <local-name>[Is EV]</local-name>
            <parent-name>[tableau_cars_flat#csv]</parent-name>
            <remote-alias>Is EV</remote-alias>
            <ordinal>17</ordinal>
            <local-type>boolean</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
      <column datatype='string' name='[State]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
      <column datatype='string' name='[Maker (legal entity)]' role='dimension' type='nominal' />
      <column datatype='string' name='[Powertrain]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Registrations]' role='measure' type='quantitative' />
      <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
      <column datatype='string' name='[Parent Group]' role='dimension' type='nominal' />
      <column datatype='string' name='[Origin Country]' role='dimension' type='nominal' />
      <column datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column datatype='string' name='[State Code]' role='dimension' type='nominal' />
      <column datatype='string' name='[State or UT]' role='dimension' type='nominal' />
      <column datatype='string' name='[Map Location]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
      <column datatype='string' name='[Month Name]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Month Number]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Quarter]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Days Covered]' role='measure' type='quantitative' />
      <column datatype='boolean' name='[Is Partial Month]' role='dimension' type='nominal' />
      <column datatype='boolean' name='[Is EV]' role='dimension' type='nominal' />
      <column caption='EV Registrations' datatype='integer' name='[Calculation_ev_reg]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Is EV] THEN [Registrations] ELSE 0 END' />
      </column>
      <column caption='EV Share' datatype='real' default-format='p0.0%' name='[Calculation_ev_share]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_ev_reg]) / SUM([Registrations])' />
      </column>
      <column caption='Cars Per Day' datatype='real' default-format='n#,##0' name='[Calculation_per_day]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Registrations]) / SUM({ FIXED [Month Name] : MAX([Days Covered]) })' />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Total Cars'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e6ecf5' fontsize='11'>Cars registered (1 Jan - 17 Jun 2026)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='India Car Registrations 2026' name='CarData' />
          </datasources>
          <datasource-dependencies datasource='CarData'>
            <column datatype='integer' name='[Registrations]' role='measure' type='quantitative' />
            <column-instance column='[Registrations]' derivation='Sum' name='[sum:Registrations:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#111a2e' />
          </style-rule>
        </style>
        <panes>
          <pane id='1'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[CarData].[sum:Registrations:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[CarData].[sum:Registrations:qk]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='EV Share KPI'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e6ecf5' fontsize='11'>Share of new cars that are electric</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='India Car Registrations 2026' name='CarData' />
          </datasources>
          <datasource-dependencies datasource='CarData'>
            <column caption='EV Share' datatype='real' default-format='p0.0%' name='[Calculation_ev_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_ev_reg]) / SUM([Registrations])' />
            </column>
            <column-instance column='[Calculation_ev_share]' derivation='Sum' name='[sum:Calculation_ev_share:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#111a2e' />
          </style-rule>
        </style>
        <panes>
          <pane id='1'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[CarData].[sum:Calculation_ev_share:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[CarData].[sum:Calculation_ev_share:qk]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='Monthly Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e6ecf5' fontsize='11'>Cars registered per day, by powertrain</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='India Car Registrations 2026' name='CarData' />
          </datasources>
          <datasource-dependencies datasource='CarData'>
            <column caption='Cars Per Day' datatype='real' default-format='n#,##0' name='[Calculation_per_day]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Registrations]) / SUM({ FIXED [Month Name] : MAX([Days Covered]) })' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Powertrain]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_per_day]' derivation='Sum' name='[sum:Calculation_per_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Month]' derivation='Month-Trunc' name='[tmn:Month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Powertrain]' derivation='None' name='[none:Powertrain:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#111a2e' />
          </style-rule>
        </style>
        <panes>
          <pane id='1'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Area' />
            <encodings>
              <color column='[CarData].[none:Powertrain:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[CarData].[sum:Calculation_per_day:qk]</rows>
        <cols>[CarData].[tmn:Month:ok]</cols>
      </table>
    </worksheet>
    <worksheet name='EV Share Curve'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e6ecf5' fontsize='11'>EV share of new cars, month by month</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
